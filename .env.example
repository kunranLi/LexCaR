# DMXAPI key for Jev judgment and light LLM (https://www.dmxapi.cn)
DMX_API_KEY=sk-your-key-here

# DMXAPI base URL; usually leave as-is
DMX_BASE_URL=https://www.dmxapi.cn

# Jev structured-judgment model; used for Stage2/Stage3 scoring and fact checks
JEV_MODEL=jev-1.13.0

# Light chat model: Stage1 query planning, Stage2 element derivation, Stage3 intent rewrite
LLM_MODEL=gpt-4o-mini

# Local LeCaRDv2 dir; only used for --qid sample queries, not for recall
LECARDV2_DIR=./data/lecardv2

# =============================================================================
# Per-stage parameters / timeouts (seconds)
# =============================================================================

# --- Stage1: agentic retrieval (LLM query planning + MCP case DBs) ---
# Target candidate-pool size; truncate to this after multi-round dedupe
CANDIDATE_POOL_SIZE=50
# Max extra planning rounds when recall is still short of the target
STAGE1_AGENT_MAX_ROUNDS=3
# Max case-DB tool calls per Stage1 run (protect quota)
STAGE1_MAX_TOOL_CALLS=16
# Per MCP request timeout (seconds). URLs/tools live under mcp/, not here
STAGE1_MCP_TIMEOUT=60

# Wolters Kluwer access token for ${WK_MCP_TOKEN} in mcp/wk.json; empty skips WK
WK_MCP_TOKEN=

# PKULaw access token for ${PKULAW_MCP_TOKEN} in mcp config; empty skips PKULaw
PKULAW_MCP_TOKEN=

# Query-planning temperature (slightly higher helps diversify angles)
STAGE1_PLAN_TEMPERATURE=0.2
# Field-extraction temperature from raw DB text; 0 = minimal rewrite
STAGE1_EXTRACT_TEMPERATURE=0
# Max natural-language semantic queries per round
STAGE1_SEMANTIC_QUERY_COUNT=4
# Max keyword queries per round
STAGE1_KEYWORD_QUERY_COUNT=4
# Min terms per keyword query
STAGE1_KEYWORD_MIN_TERMS=2
# Max terms per keyword query
STAGE1_KEYWORD_MAX_TERMS=6
# Drop semantic queries shorter than this many characters
STAGE1_SEMANTIC_MIN_CHARS=8
# Drop keyword queries shorter than this many characters
STAGE1_KEYWORD_MIN_CHARS=2
# Max raw case-DB characters sent to the extraction model
STAGE1_EXTRACT_MAX_CHARS=12000
# Max characters written to fulltext per case-number chunk of plain text
STAGE1_TEXT_CHUNK_CHARS=4000
# Max case-text chars for fallback retrieval when planning fails
STAGE1_FALLBACK_QUERY_CHARS=400
# Max characters for the planned cause-of-action field
STAGE1_CAUSE_MAX_CHARS=40
# Max characters for the planned dispute-focus field
STAGE1_FOCUS_MAX_CHARS=200

# --- Stage2: 3-D rerank + checklist + fact confirmation ---
# Top-K cases kept after Stage2.1 3-D Jev rerank
TOP_K_AFTER_STAGE2=10
# Concurrent Jev worker threads for Stage2/Stage3 (too high may rate-limit)
JEV_MAX_WORKERS=8
# Char budget for fact summary (document head) in Jev compare
CASE_FACT_MAX_CHARS=1500
# Char budget for adjudication summary (court opinion / tail) in Jev compare
CASE_ADJUDICATION_MAX_CHARS=4000
# Soft total-length cap after concatenating fact + adjudication summaries
CASE_TEXT_MAX_CHARS=6000
# Max user-query characters when building Jev/LLM inputs
QUERY_TEXT_MAX_CHARS=2500
# Number of high-relevance precedents fed to the LLM in Stage2.2
STAGE2_CHECKLIST_TOP_N=10
# Min atomic elements in Stage2.2; one fact per question; request another round if short
STAGE2_CHECKLIST_MIN_QUESTIONS=12
# Max atomic elements in Stage2.2 to avoid too many fact checks at once
STAGE2_CHECKLIST_MAX_QUESTIONS=18
# Truncate each precedent adjudication brief in Stage2.2 (context/cost control)
STAGE2_CASE_BRIEF_MAX_CHARS=600
# Stage2.3: treat as established/sufficient only when prob reaches this threshold
STAGE2_FACT_PROB_THRESHOLD=0.5

# --- Stage3: user follow (in-pool rerank / filter) ---
# Top-K rows shown and written to history in Stage3
STAGE3_TOP_K=10
# Default weight when the user adds a ranking criterion
STAGE3_DEFAULT_DIM_WEIGHT=0.3
# Filter: drop a candidate only when Jev exclude-prob reaches this threshold
STAGE3_FILTER_THRESHOLD=0.5
# Query truncate length when Stage3 LLM rewrites dimension/filter questions
STAGE3_LLM_QUERY_MAX_CHARS=1200

# --- HTTP timeouts and retries (seconds) ---
# Max retries after a failed DMXAPI request
DMX_MAX_RETRIES=3
# Per-request timeout for light LLM (chat/completions)
LLM_TIMEOUT=90
# Default Jev timeout; used when a stage has no override
JEV_TIMEOUT=90
# Timeout for all Stage2 Jev calls (3-D rerank, fact confirmation)
JEV_TIMEOUT_STAGE2=90
# Timeout for all Stage3 Jev calls (in-pool rerank, filter judgment)
JEV_TIMEOUT_STAGE3=90

# =============================================================================
# Stage1 prompts (use \n for multi-line)
# =============================================================================

# At retrieval start, pick skills from skills/ based on the case
PROMPT_STAGE1_SKILL_SELECT_SYSTEM=你是法律案例检索智能体。根据案情，从技能目录里选择本次检索要遵循的技能。用户新增加的技能，只要和类案检索、检索范围、检索式或案例筛选有关，就应当选上。只输出 JSON。
# Placeholders: {query} {catalog} {example_json}
PROMPT_STAGE1_SKILL_SELECT_USER=【用户案情】\n{query}\n\n【技能目录】\n{catalog}\n\n输出 JSON，格式示例：\n{example_json}
# JSON example the skill-selection model should imitate
PROMPT_STAGE1_SKILL_SELECT_EXAMPLE_JSON={"skills":["case-retrieval"]}
# Query-planning system prompt; selected skill bodies are appended after this
PROMPT_STAGE1_PLAN_SYSTEM=你是法律案例检索智能体的查询规划器。严格遵循已调用的技能，只根据给出的 MCP 工具 schema 发起工具调用。案件类型以用户案情为准，可以是刑事、民事、行政或其他类型；工具若有类型参数，必须使用 schema 中的全称，不要默认刑事案件。不要编写任何案例、案号或裁判要旨。只输出 JSON。
# Query-planning user prompt. Placeholders: {query} {tools} {example_json} {max_calls} {semantic_count} {keyword_count} {keyword_min_terms} {keyword_max_terms} {followup}
PROMPT_STAGE1_PLAN_USER=【用户案情】\n{query}\n\n【可用 MCP 工具】\n{tools}\n\n请输出工具调用 JSON，格式示例：\n{example_json}\n\nserver 和 tool 必须来自上面的列表，arguments 只能使用该工具列出的参数。本轮最多 {max_calls} 次调用。语义检索最多 {semantic_count} 次，关键词检索最多 {keyword_count} 次。关键词每条 {keyword_min_terms} 到 {keyword_max_terms} 个词。示例只说明 JSON 结构，检索词和案件类型必须来自用户案情，不要照抄示例。{followup}
# JSON example for query planning; do not copy the sample case facts
PROMPT_STAGE1_PLAN_EXAMPLE_JSON={"calls":[{"server":"pkulaw-semantic","tool":"search_case","arguments":{"text":"房屋买卖合同解除后已付购房款应否返还","case_type":"民事案件","size":10}}]}
# Follow-up planning hint when recall is short. Placeholders: {already} {found} {target} {titles}
PROMPT_STAGE1_PLAN_FOLLOWUP=\n\n已经调用过的工具：{already}\n目前去重后只有 {found} 条，目标 {target} 条。\n已有标题示例：{titles}\n请换角度再给一批不重复的工具调用。
# System prompt to extract fields when the case DB returns unstructured text
PROMPT_STAGE1_EXTRACT_SYSTEM=你只从给定的案例库原文中抽取案例字段，禁止补充原文没有的案号、事实或裁判。charges 填写原文中的案由或罪名，民事和行政案件写案由。输出 JSON：{"cases":[{"doc_id":"","title":"","court":"","charges":[],"fact":"","reason":"","result":"","fulltext":"","url":"","articles":[]}]}

# =============================================================================
# Stage2 prompts (use \n for multi-line)
# =============================================================================

# Stage2.2 checklist system prompt; based only on precedent adjudication briefs
PROMPT_LLM_CHECKLIST_SYSTEM=你是中国裁判要件抽取助手。先例可能是刑事、民事、行政或其他案件。只从裁判说理中抽取法院作出裁判主文之前用来认定的法律要件，写成是否问句。每个问句都要明确指向一个法律要件，写出要件名称，不能只问生活事实。例如写「是否具有抢劫罪的非法占有目的」「是否以麻醉方法作为抢劫手段」，不要写「是否使用麻醉药物」「是否有认罪态度」「是否情节严重」。一个问题只能有一个要件，目的、手段、场所、结果、从宽情节必须拆开，不能用逗号或「并」「且」「以及」写在同一问。不要抽取判决主文之后的执行和告知事项，例如刑期起算、羁押折抵、上诉权利、罚金缴纳期限、剥夺政治权利的宣告、判决生效后如何履行。禁止总括问题，例如「是否符合某罪的构成要件」「是否存在从轻或从重情节」「证据是否充分」「量刑是否适当」「辩护意见是否被采纳」。民事写具体责任要件，行政写具体合法性要件，不要改写成罪名或量刑。不要抽取说理没有讨论的要件来凑数，不要依赖或臆造用户案情；只输出 JSON。
# Stage2.2 checklist user prompt. Placeholders: {top_k} {case_briefs} {example_json} {min_questions} {max_questions}
PROMPT_LLM_CHECKLIST_USER=【高相关先例裁判摘要 Top-{top_k}】\n{case_briefs}\n\n请仅依据上述裁判摘要，提取裁判要件清单，输出 JSON，格式示例：\n{example_json}\n\n要求：生成 {min_questions}～{max_questions} 个问题，id 用 q1/q2...。只列本院认为里作为定案依据的法律要件，摘要里每出现一个独立要件就单列一问。不要合并，也不要为了凑数编造说理里没有的要件，不要抽取判决主文和执行事项。每个问题只有一个要件，问句里必须出现该要件的法律名称。不要用逗号、分号、「并」「且」「以及」「同时」连接第二个要件。name 用该要件的短名。示例只说明写法，不要照抄示例中的案情；摘要不是抢劫时，不要输出入户、麻醉、退赔。不要出现对「用户案情」的引用。
# Stage2.2 checklist format example; do not copy the sample case facts
PROMPT_LLM_CHECKLIST_EXAMPLE_JSON={"questions":[{"id":"q1","name":"非法占有目的","question":"是否具有抢劫罪的非法占有目的？","rationale":"说理将非法占有目的作为抢劫罪的主观要件"},{"id":"q2","name":"入户加重","question":"是否属于入户抢劫这一加重情节？","rationale":"说理将入户作为抢劫的加重情节"},{"id":"q3","name":"麻醉手段","question":"是否以麻醉方法作为抢劫手段？","rationale":"说理将药物麻醉作为抢劫的手段要件"},{"id":"q4","name":"不能反抗","question":"是否达到抢劫手段所要求的不能反抗？","rationale":"说理将不能反抗作为麻醉手段的结果状态"},{"id":"q5","name":"劫取财物","question":"是否具备当场劫取财物这一结果要件？","rationale":"说理将当场取得财物作为抢劫的结果要件"},{"id":"q6","name":"自动投案","question":"是否具备自首所要求的自动投案？","rationale":"说理将自动投案作为自首的构成事实"},{"id":"q7","name":"如实供述","question":"是否具备自首所要求的如实供述主要犯罪事实？","rationale":"说理将如实供述作为自首中独立于自动投案的事实"},{"id":"q8","name":"退赔违法所得","question":"是否具有退赔这一从宽情节？","rationale":"说理将退赔作为量刑从宽情节"}]}
# Fallback question JSON when Stage2.2 checklist generation fails
PROMPT_LLM_CHECKLIST_FALLBACK_JSON=[{"id":"q1","name":"案由或法律关系","question":"裁判是否围绕与该类案件相同的案由、罪名或法律关系展开？","rationale":"先例说理通常先确定案件性质"},{"id":"q2","name":"争议焦点","question":"裁判是否处理了该类案件的主要争议焦点？","rationale":"先例说理围绕争议焦点展开"},{"id":"q3","name":"关键事实","question":"裁判是否依赖与该类案件相似的关键事实？","rationale":"先例将关键事实作为认定基础"},{"id":"q4","name":"裁判结果","question":"裁判结果的处理方式对该类案件是否具有参考意义？","rationale":"先例结论体现可参考的处理方式"}]

# Stage2.1 / Stage3 preset 3-D rerank dimensions; JSON array; question is the Jev prompt
PROMPT_JEV_STAGE2_DIMENSIONS_JSON=[{"id":"similar_cause","name":"案由或法律关系是否相近","weight":0.5,"question":"仅根据本案与候选案例的事实及裁判说理判断：二者的案由、罪名或法律关系是否相同或相近？刑事案件比较罪名，民事案件比较案由与请求权，行政案件比较被诉行政行为。案件大类不同则不相近。"},{"id":"key_facts_overlap","name":"关键情节是否重合","weight":0.3,"question":"候选案例的关键事实与本案是否重合？只比较本案实际涉及的情节，如行为方式、合同履行、行政行为、损害后果、数额、过错、退赔或前科。"},{"id":"outcome_reference","name":"裁判结果是否有参考价值","weight":0.2,"question":"候选案例的裁判结果对本案是否有参考价值？刑事看定罪量刑，民事看责任承担与给付，行政看合法性判断与处理方式。"}]
# Jev compare context for query vs candidate. Placeholders: {query} {doc_id} {body}
PROMPT_JEV_COMPARE_STATE=【本案案情】\n{query}\n\n【候选案例】\n案例ID: {doc_id}\n{body}

# Query context sent to Jev for Stage2.3 fact confirmation. Placeholder: {query}
PROMPT_JEV_FACT_STATE=【本案案情】\n{query}\n\n请严格依据上述案情作答，不要臆造未出现的事实。
# Jev noul for whether an element is established. Placeholder: {question}
PROMPT_JEV_FACT_ESTABLISHED=仅根据本案案情判断：{question} 若信息不足以判断，请倾向于给出较低概率。
# Jev noul for whether the query text has enough information. Placeholder: {question}
PROMPT_JEV_FACT_SUFFICIENCY=判断本案案情文本中，是否已提供足够信息来可靠回答：{question}

# Stage3 system prompt: rewrite an added retrieval preference into a Jev question
PROMPT_LLM_STAGE3_DIM_SYSTEM=你是法律检索系统中的问题生成器。把用户的检索偏好改写成一个清晰的 Boolean（是/否）Jev 判定问题，用于比较「本案」与「候选案例」是否匹配该偏好。只输出 JSON。
# Stage3 user prompt for a new dimension. Placeholders: {query} {user_intent} {existing_questions} {example_json}
PROMPT_LLM_STAGE3_DIM_USER=【本案案情】\n{query}\n\n【用户新增检索重点】\n{user_intent}\n\n【已有维度问题】\n{existing_questions}\n\n输出 JSON，格式示例：\n{example_json}
# JSON example for Stage3 new-dimension rewrite
PROMPT_LLM_STAGE3_DIM_EXAMPLE_JSON={"id":"dim_focus","name":"争议焦点重合","question":"候选案例是否与用户关注的争议焦点直接相关？"}
# Fallback Jev question when Stage3 dimension rewrite fails. Placeholder: {user_intent}
PROMPT_JEV_STAGE3_DIM_FALLBACK=候选案例是否体现用户关注的情节：{user_intent}？

# Stage3 system prompt: rewrite an exclude preference into a Jev filter question
PROMPT_LLM_STAGE3_FILTER_SYSTEM=你是法律检索系统中的过滤条件生成器。把用户的排除偏好改写成一个 Boolean 问题：若对候选案例回答「是」，则该案例应被排除。只输出 JSON。
# Stage3 user prompt for exclude filters. Placeholders: {query} {user_intent} {example_json}
PROMPT_LLM_STAGE3_FILTER_USER=【本案案情】\n{query}\n\n【用户排除偏好】\n{user_intent}\n\n输出 JSON，格式示例：\n{example_json}
# JSON example for Stage3 exclude-filter rewrite
PROMPT_LLM_STAGE3_FILTER_EXAMPLE_JSON={"id":"flt_unrelated","name":"排除无关案件","question":"该候选案例是否属于用户声明要排除的案件类型？"}
# Fallback Jev question when Stage3 filter rewrite fails. Placeholder: {user_intent}
PROMPT_JEV_STAGE3_FILTER_FALLBACK=该候选案例是否属于用户不想要的类型：{user_intent}？
